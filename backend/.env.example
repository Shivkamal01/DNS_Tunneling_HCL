# ─── Database Configuration ──────────────────────────────
# PostgreSQL connection credentials
DB_NAME=dns_tunneling_db
DB_USER=db_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── Zeek Log Path ──────────────────────────────────────
# Override if your Zeek dns.log is in a non-default location.
# On Windows: Leave unset to use <project_root>\zeek\logs\dns.log
# ZEEK_LOG_PATH=C:\path\to\your\dns.log
